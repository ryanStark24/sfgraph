                "informationUri": "https://github.com/ryanStark24/sfgraph",
                "rules": [
                  {
                    "id": "dead-code.unreferenced",
                    "name": "Unreferenced metadata",
                    "shortDescription": {
                      "text": "Node has no incoming edges and is not an obvious entry point."
                    },
                    "fullDescription": {
                      "text": "Apex/LWC/Flow components with no incoming references are candidates for deletion. Note that some entry points (AuraEnabled, REST endpoints, scheduled jobs) are only reachable from outside the org and will show up here legitimately — verify before deleting."
                    },
                    "defaultConfiguration": {
                      "level": "note"
                    },
                    "properties": {
                      "tags": ["dead-code"]
                    }
                  },
                  {
                    "id": "governor.dml-in-loop",
                    "name": "DML in loop",
                    "shortDescription": {
                      "text": "Apex method executes DML inside a loop."
                    },
                    "fullDescription": {
                      "text": "Detected via the `hasDmlInLoop` attribute set by Apex parsing. Each loop iteration consumes one of the 150 DML statements the platform allows per transaction — bulkify by collecting records into a list and committing once after the loop."
                    },
                    "defaultConfiguration": {
                      "level": "error"
                    },
                    "properties": {
                      "tags": ["governor"]
                    }
                  },
                  {
                    "id": "governor.soql-in-loop",
                    "name": "SOQL in loop",
                    "shortDescription": {
                      "text": "Apex method executes SOQL inside a loop."
                    },
                    "fullDescription": {
                      "text": "Detected via the `hasSoqlInLoop` attribute set by Apex parsing. Each loop iteration consumes one of the 100 SOQL queries the platform allows per transaction — bulkify by moving the query outside the loop and consuming the results inline."
                    },
                    "defaultConfiguration": {
                      "level": "error"
                    },
                    "properties": {
                      "tags": ["governor"]
                    }
                  },
                  {
                    "id": "graph.dangling-edge",
                    "name": "Dangling edge",
                    "shortDescription": {
                      "text": "Edge points to a destination node that doesn't exist in the graph."
                    },
                    "fullDescription": {
                      "text": "Dangling edges usually indicate ingest gaps (a metadata type that didn't get extracted) or stale references (managed-package targets no longer installed). Investigate which extractor would own the missing dst label."
                    },
                    "defaultConfiguration": {
                      "level": "note"
                    },
                    "properties": {
                      "tags": ["graph"]
                    }
                  },
                  {
                    "id": "security.fls-gap",
                    "name": "Field-level security gap",
                    "shortDescription": {
                      "text": "CustomField has no FLS grant on any profile/permission set."
                    },
                    "fullDescription": {
                      "text": "Fields with no FLS grant are invisible to every user in API and UI alike. Either remove the field if unused or grant access on the appropriate permission set."
                    },
                    "defaultConfiguration": {
                      "level": "warning"
                    },
                    "properties": {
                      "tags": ["security"]
                    }
                  },
                  {
                    "id": "security.sharing-full-access",
                    "name": "Object granted full access via sharing",
                    "shortDescription": {
                      "text": "OWD or sharing rule grants Modify All / View All to a broad audience."
                    },
                    "fullDescription": {
                      "text": "Granting full access via OWD or sharing rules bypasses field-level security and CRUD checks. Review whether the audience genuinely needs unrestricted access; prefer scoped permission sets."
                    },
                    "defaultConfiguration": {
                      "level": "warning"
                    },
                    "properties": {
                      "tags": ["security"]
                    }
                  }
                ]
              }
